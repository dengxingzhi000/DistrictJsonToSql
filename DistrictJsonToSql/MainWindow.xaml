<Window
    x:Class="DistrictJsonToSql.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="地域JSON转SQL工具">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：与 Mica 背景连成一片，右侧留出系统窗口按钮区域 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="地域JSON转SQL工具"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 标题区 -->
        <StackPanel Grid.Row="1" Margin="24,16,24,10" Spacing="2">
            <TextBlock Text="地域 JSON → SQL" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="选择行政区划 JSON，生成可直接执行的 PostgreSQL INSERT 语句"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 分组 1：输入 -->
        <Border Grid.Row="2" Margin="24,0,24,8" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="输入文件" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FilePathBox" Grid.Column="0" IsReadOnly="True" IsTabStop="False"
                             Text="{Binding SelectedFilePath, Mode=OneWay}"
                             PlaceholderText="尚未选择 JSON 文件"
                             AutomationProperties.Name="已选择的 JSON 文件路径（只读）"
                             VerticalAlignment="Center" />

                    <Button x:Name="SelectButton" Grid.Column="1" MinWidth="120"
                            Command="{Binding SelectFileCommand}"
                            ToolTipService.ToolTip="选择 JSON 文件（Ctrl+O）"
                            AutomationProperties.Name="选择 JSON 文件">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text="选择文件" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 分组 2：高级参数，默认收起，不打断主流程 -->
        <Border Grid.Row="3" Margin="24,0,24,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Expander x:Name="AdvancedOptions"
                      Padding="16,0,16,12"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="高级选项：目标表名与每批行数" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>

                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Header="目标表名"
                             Text="{Binding TableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="public.tb_district"
                             AutomationProperties.Name="目标表名" />

                    <TextBox Grid.Column="1" Header="每批 INSERT 行数"
                             Text="{Binding BatchSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="100"
                             AutomationProperties.Name="每批 INSERT 行数" />
                </Grid>
            </Expander>
        </Border>

        <!-- 分组 3：操作。生成是唯一主操作（accent），左侧说明为什么当前不可用 -->
        <Grid Grid.Row="4" Margin="24,0,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Text="请先选择 JSON 文件，再点击「生成 SQL」"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowGenerateHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ProgressRing Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center"
                          IsActive="{Binding IsBusy, Mode=OneWay}"
                          Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <Button x:Name="GenerateButton" Grid.Column="2" MinWidth="148"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding GenerateSqlCommand}"
                    ToolTipService.ToolTip="生成 SQL 并写入同名 .sql 文件（Ctrl+Enter）"
                    AutomationProperties.Name="生成 SQL">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                    <TextBlock Text="生成 SQL" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 状态条：信息 / 成功 / 警告 / 错误 -->
        <InfoBar x:Name="StatusBar" Grid.Row="5" Margin="24,0,24,8"
                 IsOpen="{Binding IsStatusOpen, Mode=OneWay}"
                 Title="{Binding StatusTitle, Mode=OneWay}"
                 Message="{Binding StatusMessage, Mode=OneWay}"
                 Severity="{Binding StatusSeverity, Mode=OneWay, Converter={StaticResource StatusToInfoBarSeverity}}"
                 IsClosable="False" />

        <!-- 分组 4：结果（预览 + 输出路径），空状态与结果共用同一区域 -->
        <Border Grid.Row="6" Margin="24,0,24,24" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="生成结果" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding OutputFilePath, Mode=OneWay}"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding ShowOutput, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="EmptyState"
                                Visibility="{Binding ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="32"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="尚未生成 SQL"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="选择 JSON 文件后点击「生成 SQL」"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="SqlOutput" IsReadOnly="True"
                             Text="{Binding SqlText, Mode=OneWay}"
                             Visibility="{Binding ShowOutput, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             IsSpellCheckEnabled="False"
                             FontFamily="Consolas"
                             AutomationProperties.Name="生成的 SQL 预览"
                             PlaceholderText="生成的 SQL 会显示在这里"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
