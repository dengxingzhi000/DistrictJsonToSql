<Window
    x:Class="DistrictJsonToSql.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="地域JSON转SQL工具">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：与 Mica 背景连成一片，右侧留出系统窗口按钮区域 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="地域JSON转SQL工具"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 标题区：TitleTextBlockStyle / BodyTextBlockStyle 两级阶梯 -->
        <StackPanel Grid.Row="1" Margin="24,16,24,12" Spacing="4">
            <TextBlock Text="地域 JSON → SQL" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="选择行政区划 JSON，生成可直接执行的 PostgreSQL INSERT 语句"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 文件与操作卡片 -->
        <Border Grid.Row="2" Margin="24,0,24,12" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FilePathBox" Grid.Column="0" IsReadOnly="True"
                         Text="{Binding SelectedFilePath, Mode=OneWay}"
                         PlaceholderText="尚未选择 JSON 文件"
                         VerticalAlignment="Center" />

                <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="20" Height="20"
                              IsActive="{Binding IsBusy, Mode=OneWay}"
                              VerticalAlignment="Center" />

                <Button x:Name="SelectButton" Grid.Column="2"
                        Command="{Binding SelectFileCommand}" MinWidth="132"
                        AutomationProperties.Name="选择 JSON 文件">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock Text="选择 JSON 文件" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="GenerateButton" Grid.Column="3"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding GenerateSqlCommand}" MinWidth="112"
                        AutomationProperties.Name="生成 SQL">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                        <TextBlock Text="生成 SQL" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 状态条：信息 / 成功 / 警告 / 错误，带内建图标 -->
        <InfoBar x:Name="StatusBar" Grid.Row="3" Margin="24,0,24,12"
                 IsOpen="{Binding IsStatusOpen, Mode=OneWay}"
                 Title="{Binding StatusTitle, Mode=OneWay}"
                 Message="{Binding StatusMessage, Mode=OneWay}"
                 Severity="{Binding StatusSeverity, Mode=OneWay, Converter={StaticResource StatusToInfoBarSeverity}}"
                 IsClosable="False" />

        <!-- 输出卡片：空状态与结果共用同一区域 -->
        <Border Grid.Row="4" Margin="24,0,24,24" Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="生成结果" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Grid Grid.Row="1">
                    <StackPanel x:Name="EmptyState"
                                Visibility="{Binding ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="32"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="尚未生成 SQL"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="选择 JSON 文件后点击「生成 SQL」"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="SqlOutput" IsReadOnly="True"
                             Text="{Binding SqlText, Mode=OneWay}"
                             Visibility="{Binding ShowOutput, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             IsSpellCheckEnabled="False"
                             FontFamily="Consolas"
                             PlaceholderText="生成的 SQL 会显示在这里"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
