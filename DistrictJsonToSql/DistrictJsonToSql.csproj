<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DistrictJsonToSql</RootNamespace>
    <AssemblyName>DistrictJsonToSql</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>2.1.0</Version>

    <!-- unpackaged + self-contained + 单文件（Windows App SDK 官方要求的属性组合） -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DistrictJsonToSql.Core\DistrictJsonToSql.Core.csproj" />
    <ProjectReference Include="..\DistrictJsonToSql.Presentation\DistrictJsonToSql.Presentation.csproj" />
  </ItemGroup>

</Project>
